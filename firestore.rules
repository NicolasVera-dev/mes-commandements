rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Document utilisateur
    match /users/{userId} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;

      // Carnet de bord : tâches et bilans isolés par compte.
      match /journal_tasks/{taskId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'title', 'priority', 'order', 'plans', 'originalDay', 'completedDay', 'removedDay'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && request.resource.data.originalDay is string
          && request.resource.data.priority is bool
          && request.resource.data.order is number
          && request.resource.data.plans is list
          && request.resource.data.plans.size() > 0
          && request.resource.data.plans.size() <= 500
          && (request.resource.data.completedDay == null || request.resource.data.completedDay is string)
          && (request.resource.data.removedDay == null || request.resource.data.removedDay is string);
      }

      match /journal_reflections/{dayId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['note', 'mood'])
          && dayId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 4000
          && request.resource.data.mood in [null, 'difficult', 'mixed', 'satisfied'];
      }

      // Commandements de l'utilisateur
      match /commands/{commandId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;

        // Historique des événements
        match /events/{eventId} {
          allow read, write: if request.auth != null
                             && request.auth.uid == userId;
        }

        // Notes par cycle (jour / semaine / mois / année)
        match /cycle_notes/{noteId} {
          allow read, write: if request.auth != null
                             && request.auth.uid == userId;
        }
      }

      match /resistances/{resistanceId} {
        allow read, write: if request.auth != null
                           && request.auth.uid == userId;

        match /relapses/{relapseId} {
          allow read, write: if request.auth != null
                             && request.auth.uid == userId;
        }

        match /day_notes/{noteId} {
          allow read, write: if request.auth != null
                             && request.auth.uid == userId;
        }
      }
    }

    // Tout le reste est refusé par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
